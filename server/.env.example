# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database  (local MongoDB or MongoDB Atlas connection string)
#   Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/support_platform
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/support_platform

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
SUPPORT_TOKEN_EXPIRES_IN=12h

# ---------------------------------------------------------------------------
# Customer membership portal
#   Separate auth from admin/staff. Cookies are HTTP-only; set CROSS_SITE=true
#   only when the SPA and API are on different origins over HTTPS.
# ---------------------------------------------------------------------------
CUSTOMER_TOKEN_EXPIRES_IN=2h
CUSTOMER_COOKIE_NAME=portal_session
CUSTOMER_COOKIE_CROSS_SITE=false
CUSTOMER_RESET_TOKEN_MINUTES=60
LAUNCH_TOKEN_MINUTES=5
# Require email verification before a customer can sign in. Leave false until a
# mail transport is wired up, or new registrations cannot log in.
CUSTOMER_REQUIRE_EMAIL_VERIFICATION=false

# Public origin of this deployment — used to build password-reset links.
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# JVZoo IPN (payment webhook)
#   JVZOO_IPN_SECRET is the secret key from your JVZoo seller dashboard. It is
#   used to verify the `cverify` signature on every IPN and MUST NEVER be sent
#   to the browser. With the webhook enabled but no secret set, incoming IPNs
#   are stored for audit and rejected as unverified (no access granted).
# ---------------------------------------------------------------------------
JVZOO_WEBHOOK_ENABLED=false
JVZOO_IPN_SECRET=
# Production gate. Keep FALSE until you have validated JVZoo's signature scheme
# against a REAL test IPN end to end. While false the verifier returns BLOCKED
# and NO event can grant access — events are still stored for audit.
JVZOO_VERIFICATION_CONFIRMED=false

# ---------------------------------------------------------------------------
# Transactional email (Resend)  — https://resend.com/api-keys
#   Powers sign-up welcome/verification, password-reset, and the "email
#   everyone" step of a JVZoo CSV import.
#   Leave RESEND_API_KEY empty to run without sending: every email is logged
#   (with its action link) instead, so all flows stay testable in dev.
#   MAIL_FROM must be an address on a domain you've verified in Resend. For a
#   quick test, "onboarding@resend.dev" only delivers to the Resend account owner.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=Customer Support <onboarding@resend.dev>
MAIL_REPLY_TO=
APP_NAME=Customer Support
MAIL_BRAND_COLOR=#4f46e5
# Delay (ms) between batch sends during CSV import, to stay under Resend's rate limit.
MAIL_BATCH_DELAY_MS=600
# Global kill switch for CSV-import notification emails (per-import: send notify=false).
MAIL_CSV_IMPORT_NOTIFY=true

# ---------------------------------------------------------------------------
# Google Gemini  (BACKEND ONLY - never expose to the React client)
#   Get a key: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# ---------------------------------------------------------------------------
# RAG / retrieval
#   ATLAS_VECTOR_SEARCH=true  requires an Atlas Search index named
#   VECTOR_INDEX_NAME on the knowledgechunks collection (see README).
# ---------------------------------------------------------------------------
ATLAS_VECTOR_SEARCH=false
VECTOR_INDEX_NAME=knowledge_vector_index
RAG_TOP_K=6
RAG_MIN_SCORE=0.55

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Seed admin (used by `npm run seed`)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@support.local
SEED_ADMIN_PASSWORD=Admin@12345
