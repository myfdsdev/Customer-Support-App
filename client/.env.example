# ---------------------------------------------------------------------------
# Frontend configuration
#
# Vite inlines these at BUILD time, not at runtime. Changing them on your host
# requires a rebuild/redeploy — restarting the service is not enough.
# Only VITE_-prefixed variables are exposed to the browser; never put the
# Gemini key or the Mongo URI here.
# ---------------------------------------------------------------------------

# Where the API lives.
#
#   Leave EMPTY when the frontend and API are served by the same host
#   (local development via the Vite proxy, or a single-service deployment).
#
#   Set it to the API service origin when they are deployed separately:
#     VITE_API_URL=https://your-api.onrender.com
#
#   The trailing "/api" is optional — both of these resolve identically:
#     https://your-api.onrender.com
#     https://your-api.onrender.com/api
VITE_API_URL=

# Websocket origin. Leave EMPTY — it is derived from VITE_API_URL.
# Only set this if Socket.io is served from a different host than the REST API.
VITE_SOCKET_URL=
